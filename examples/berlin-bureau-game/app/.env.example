# Server-side only. The browser never sees these.
OPENROUTER_API_KEY=sk-or-v1-...
# Optional: any valid OpenRouter model slug. Defaults to anthropic/claude-sonnet-4.6.
# A stronger model runs the GM better (e.g. anthropic/claude-sonnet-5, anthropic/claude-opus-4.8).
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
