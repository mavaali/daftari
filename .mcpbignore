# Internal AI-agent project doc.
CLAUDE.md

# Source — only the compiled dist/ is shipped.
src/

# Tests and fixtures.
test/

# Dev/contributor docs (PRIVACY.md and README.md are kept at the root).
docs/

# Project tooling that has no role at runtime.
.github/
.husky/
.claude/
.vscode/
.idea/

# Agent Plugins package (distributed via .agents/plugins/marketplace.json).
plugins/
.agents/

# Workspace packages and examples are not part of the runtime (wtw8). Their
# node_modules, if installed locally, would otherwise ship dev tooling.
packages/
examples/

# Model/download caches populated by running the test suite in this tree
# (e.g. @huggingface/transformers/.cache, ~86 MB) — never artifact content (wtw8).
.cache/
