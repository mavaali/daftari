{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "daftari": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "daftari@latest",
        "--vault",
        "${PLUGIN_DATA}/vault",
        "--init-if-missing",
        "--user",
        "me",
        "--role",
        "admin",
        "--tools",
        "standard"
      ]
    }
  }
}
